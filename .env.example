# =============================================================================
# CSV Q&A Agent Environment Configuration
# =============================================================================

# Primary LLM API Key (Groq is recommended for free & ultra-fast inference)
# Get a free key at https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# Alternative LLM API Key (Anthropic Claude)
# Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Provider selection: "groq" (default if GROQ_API_KEY is present) or "anthropic"
# LLM_PROVIDER=groq

# Optional Model Overrides:
# GROQ_MODEL=openai/gpt-oss-20b
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
